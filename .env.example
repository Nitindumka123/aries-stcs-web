# STCS Modernization - Environment Variables
# .env.example contains placeholders only - never commit real .env to Git
# Copy this file to .env and fill in actual values for local development

# --- Telescope Operating Mode ---
# "REAL" = Read positions from encoder Arduinos (RA, DEC, Dome hardware)
# "SIMULATION" = Use physics engine to simulate telescope position
TELESCOPE_MODE=REAL
# TELESCOPE_MODE=SIMULATION

# --- ASCOM Alpaca Server ---
# HTTP API host for Cartes du Ciel integration
ALPACA_HOST=0.0.0.0
# ASCOM Alpaca Server port (default: 11111)
ALPACA_PORT=11111

# --- Slew Control ---
# Delay in seconds when slew speed changes (gear protection)
SLEW_SPEED_TRANSITION_DELAY_SEC=3

# --- Dome Geometry ---
# DOME_MAX_SPEED_DPS=1.354
# DOME_RAMP_TIME_S=5.0
# DOME_AZ_OFFSET=0
# DOME_SYNC_TOLERANCE_DEG=5.0
# DOME_COAST_DEG=3.6

# --- Dome Geometry Constants (ARIES 104 cm legacy defaults) ---
# Tune these values if dome behavior needs adjustment
DOME_GEOMETRY_ENABLED=true
DOME_RADIUS_M=5.31
DOME_OPTICAL_AXIS_OFFSET_M=1.58
DOME_OFFSET_X_M=0.0
DOME_OFFSET_Y_M=0.0
DOME_OFFSET_Z_M=0.95

# --- Database Configuration (PostgreSQL) ---
# Production: These MUST be set via environment variables.
# The real PostgreSQL password must NEVER appear in source code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stcs_observatory
DB_USER=stcs_user
DB_PASSWORD=your_postgres_password_here

# --- Authentication ---
# Secret key for session signing — must be unique and random in production
SESSION_SECRET=your_session_secret_here
# SESSION_SECRET is used for signing Starlette session cookies

# Session lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Telescope command gate ---
# 0 = commands validated only, never executed (required for all software work).
# 1 = physical motion allowed (on-site commissioning authorization only).
STCS_COMMANDS_ENABLED=0

# Development credentials (override via environment at deployment)
# These are for local development only - passwords are hashed in production.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=change_me_in_production
SCIENTIST_USERNAME=Scientist1
SCIENTIST_PASSWORD=change_me_in_production

# --- Weather & Telemetry ---
# Weather UDP broadcast port
WEATHER_PORT=12344

# --- Telemetry WebSocket Server ---
# WebSocket telemetry server host
TELEMETRY_WS_HOST=0.0.0.0
# WebSocket telemetry server port (default: 11112)
TELEMETRY_WS_PORT=11112

# --- GPS Configuration ---
# GPS serial port (AUTO = auto-discover)
# GPS_PORT=AUTO
# GPS Baudrate
# GPS_BAUDRATE=115200