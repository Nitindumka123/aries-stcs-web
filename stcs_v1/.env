# Telescope Operating Mode
# "REAL" = Read positions from encoder Arduinos (RA, DEC, Dome hardware)
# "SIMULATION" = Use physics engine to simulate telescope position
TELESCOPE_MODE=REAL
# TELESCOPE_MODE=SIMULATION

# ASCOM Alpaca Server for Cartes du Ciel 4.2.1
# HTTP API on port 11111, UDP discovery on port 32227
ALPACA_HOST=0.0.0.0
ALPACA_PORT=11111

SLEW_SPEED_TRANSITION_DELAY_SEC=3

DOME_MAX_SPEED_DPS=1.354
DOME_RAMP_TIME_S=5.0
DOME_AZ_OFFSET=0
DOME_SYNC_TOLERANCE_DEG=5.0
DOME_COAST_DEG=3.6

# Dome slit correction for the telescope being off the dome center.
# These are the ARIES 104 cm legacy defaults; tune X/Y/Z/sign if needed.
DOME_GEOMETRY_ENABLED=true
DOME_RADIUS_M=5.31
DOME_OPTICAL_AXIS_OFFSET_M=1.58
DOME_OFFSET_X_M=0.0
DOME_OFFSET_Y_M=0.0
DOME_OFFSET_Z_M=0.95
